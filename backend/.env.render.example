CRM_ENV=production
CRM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
CRM_JWT_SECRET=replace-with-a-long-random-secret
CRM_BOOTSTRAP_COMPANY_NAME=Platform Default Company
CRM_BOOTSTRAP_COMPANY_SLUG=platform-default
CRM_BOOTSTRAP_ADMIN_USERNAME=admin
CRM_BOOTSTRAP_ADMIN_PASSWORD=ChangeThisNow123
CRM_BOOTSTRAP_ADMIN_FULL_NAME=System Admin
CRM_BOOTSTRAP_ADMIN_ROLE=SuperAdmin
CRM_PUBLIC_BASE_URL=https://your-service-name.onrender.com
CRM_EXPOSE_RESET_TOKENS=false
CRM_CORS_ORIGINS=https://yourcompany-admin.example.com,https://yourapp.example.com
CRM_CORS_ALLOW_CREDENTIALS=false
